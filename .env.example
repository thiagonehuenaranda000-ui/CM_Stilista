# -----------------------------------------------------------------------------
# CM Stilista - Variables de entorno
# Copia este archivo a .env y ajusta los valores antes de desplegar.
# -----------------------------------------------------------------------------

# Ruta base del sitio.
#   - Dominio propio o repo usuario.github.io:          BASE_PATH=/
#   - GitHub Pages en repo de proyecto:                 BASE_PATH=/nombre-repo/
BASE_PATH=/

# URL canónica del sitio (SEO, Open Graph, sitemap, canonical).
# Cambiarla aquí se refleja en todo el sitio.
SITE_URL=https://usuario.github.io/cm-stilista/
